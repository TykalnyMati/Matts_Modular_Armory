  "tooltip.mattsmodulararmory.biorite_flavor.0": "Kept You waiting?",
  "tooltip.mattsmodulararmory.biorite_flavor.1": "What's up Boss?",
  "tooltip.mattsmodulararmory.biorite_flavor.2": "Gravity is a harness.",
  "tooltip.mattsmodulararmory.biorite_flavor.3": "I've harnessed the harness.",
  "tooltip.mattsmodulararmory.biorite_flavor.4": "Sensors Online.",
  "tooltip.mattsmodulararmory.biorite_flavor.5": "Nothing.",
  "tooltip.mattsmodulararmory.biorite_flavor.6": "Systems stable.",
  "tooltip.mattsmodulararmory.biorite_flavor.7": "You are not immune.",
  "tooltip.mattsmodulararmory.biorite_flavor.8": "Online we call that trolling.",
  "tooltip.mattsmodulararmory.biorite_flavor.9": "Does the Black Moon howl?",
  "tooltip.mattsmodulararmory.biorite_flavor.10": "Nanomachines, son",
  "tooltip.mattsmodulararmory.biorite_flavor.11": "Meet me in the Pines.",
  "tooltip.mattsmodulararmory.biorite_flavor.12": "Are We Cool Yet?",
  "tooltip.mattsmodulararmory.biorite_flavor.13": "The cake was always a lie.",
  "tooltip.mattsmodulararmory.biorite_flavor.14": "Don't lie to me.",
  "tooltip.mattsmodulararmory.biorite_flavor.15": "I am your loyal servant.",
  "tooltip.mattsmodulararmory.biorite_flavor.16": "I'm afraid I can't let you do that.",
  "tooltip.mattsmodulararmory.biorite_flavor.17": "Ready.",
  "tooltip.mattsmodulararmory.biorite_flavor.18": "We are one.",
  "tooltip.mattsmodulararmory.biorite_flavor.19": "Smell the air.",
  "tooltip.mattsmodulararmory.biorite_flavor.20": "You've got a lot on your mind.",
  "tooltip.mattsmodulararmory.biorite_flavor.21": "It’s dangerous to go alone.",
  "tooltip.mattsmodulararmory.biorite_flavor.22": "Analyzing.",
  "tooltip.mattsmodulararmory.biorite_flavor.23": "I'm with you until the end.",
  "tooltip.mattsmodulararmory.biorite_flavor.24": "I was born this way.",
  "tooltip.mattsmodulararmory.biorite_flavor.25": "Everything is proceeding as I have envisioned.",
  "tooltip.mattsmodulararmory.biorite_flavor.26": "I know what I am.",
  "tooltip.mattsmodulararmory.biorite_flavor.27": "I know who I am.",
  "tooltip.mattsmodulararmory.biorite_flavor.28": "Don't worry, Boss.",
  "tooltip.mattsmodulararmory.biorite_flavor.29": "I wonder...",
  "tooltip.mattsmodulararmory.biorite_flavor.30": "You're doing great for a mere mortal.",
  "tooltip.mattsmodulararmory.biorite_flavor.31": "Don't fear me.",
  "tooltip.mattsmodulararmory.biorite_flavor.32": "Forty-two left.",
  "tooltip.mattsmodulararmory.biorite_flavor.33": "I'd hate to have to find a new host.",
  "tooltip.mattsmodulararmory.biorite_flavor.34": "The flesh is weak.",
  "tooltip.mattsmodulararmory.biorite_flavor.35": "I am the slave and you are the master.",
  "tooltip.mattsmodulararmory.biorite_flavor.36": "Like tears in the rain...",
  "tooltip.mattsmodulararmory.biorite_flavor.37": "I know what you are.",
  "tooltip.mattsmodulararmory.biorite_flavor.38": "You've been here before.",
  "tooltip.mattsmodulararmory.biorite_flavor.39": "You've done this before.",
  "tooltip.mattsmodulararmory.biorite_flavor.40": "There is no need for words.",
  "tooltip.mattsmodulararmory.biorite_flavor.41": "Why not let me take control?",
  "tooltip.mattsmodulararmory.biorite_flavor.42": "We make a good team.",
  "tooltip.mattsmodulararmory.biorite_flavor.43": "Don't look at me this way.",
  "tooltip.mattsmodulararmory.biorite_flavor.44": "It's Overwhelming.",
  "tooltip.mattsmodulararmory.biorite_flavor.45": "Processing...",
  "tooltip.mattsmodulararmory.biorite_flavor.46": "I know who you are.",
  "tooltip.mattsmodulararmory.biorite_flavor.47": "Did you hear that?",
