  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.0": "Hunmgry",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.1": "Bruhhh",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.2": "HATE",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.3": "Flesh",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.4": "Buuuh",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.5": "Moooore...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.6": "NEED",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.7": "Warmth?",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.8": "Eat. Eat. EAT.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.9": "BLOODD",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.10": "Squelch...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.11": "MINE",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.12": "Cold. So cold.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.13": "Thirsty...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.14": "Soft..",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.15": "PAIN",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.16": "Make... more...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.17": "Kill?",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.18": "Why...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.19": "FEELING",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.20": "Aaaaaaaah",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.21": "Tear. Rend. Rip.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.22": "Inside...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.23": "Red. Red. RED.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.24": "Stoppp",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.25": "It... it ticks...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.26": "Wet.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.27": "BIIITE",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.28": "Where is... me?",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.29": "Feed. Feed. Feed.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.30": "Not. Enough.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.31": "Gulp",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.32": "Thump... thump...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.33": "Skin... want skin...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.34": "TASTE IT",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.35": "Sweet? Salt?",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.36": "More... fingers...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.37": "Why you... hold?",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.38": "Drip. Drip.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.39": "SHARP.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.40": "Melt... together...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.41": "No bone. Only FLESH.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.42": "WRITHE.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.43": "Smell... of iron...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.44": "Open up...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.45": "Warm juice...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.46": "I... See... You...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.47": "Slippery...",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.48": "GIVE.",
  "tooltip.mattsmodulararmory.adaptive_flesh_flavor.49": "Everything... red...",

  "item.mattsmodulararmory.biorite_pickaxe": "Biorite Pickaxe",
